# Name of the Docker network your reverse proxy (Traefik or Caddy) is attached to.
PROXY_NETWORK=proxy

# Public hostname.
VIDITOR_HOST=viditor.samuelgelacio.io

# Traefik only: names of your HTTPS entrypoint and ACME certificate resolver.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Only used if you enable the loopback `ports:` mapping in docker-compose.yml.
VIDITOR_LOCAL_PORT=8088
